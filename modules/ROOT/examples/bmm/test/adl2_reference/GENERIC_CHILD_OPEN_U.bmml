import org.openehr:representation ;

| 
| Syntax-demonstration class, converted from the ADLtest `openehr_adltest_100.bmm` ODIN
| schema. Inherits from `GENERIC_PARENT`, closing its first generic parameter to
| `SUPPLIER_A` while leaving the second open (re-declared here as `U`).
| 

class GENERIC_CHILD_OPEN_U<U:SUPPLIER>
    is_a GENERIC_PARENT<SUPPLIER_A, U>

feature_group ("access")

    prop gen_child_open_u_prop :? String;


end
