import org.openehr:representation ;

| 
| Syntax-demonstration class, converted from the ADLtest `openehr_adltest_100.bmm` ODIN
| schema. Illustrates a mix of single-valued and container properties, all optional.
| 

class TEST_ENTRY

feature_group ("access")

    prop value :? CODE_PHRASE;

    prop coded_text_value :? DV_CODED_TEXT;

    prop ordinal_attr_1 :? DV_ORDINAL;

    prop element_attr :? TEST_ELEMENT;

    prop element_attr_2 :? List<TEST_ELEMENT>;

    prop item :? DATA_VALUE;


end
