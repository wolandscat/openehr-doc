import org.openehr:representation ;
import org.openehr:foundation ;

| 
| Serialised form of Contribution for an Extract.
| 

class X_CONTRIBUTION

feature_group ("access")

    | 
    | Uid of Contribution in source system.
    | 
    prop uid : HIER_OBJECT_ID;

    | 
    | Audit of Contribution in source system.
    | 
    prop audit : AUDIT_DETAILS;

    | 
    | Serialised Versions from Contribution in source system.
    | 
    prop versions :? List<VERSION<LOCATABLE>>;


end
