import org.openehr:representation ;

| 
| Enumeration of possible position of operator in a syntactic representation for operators
| associated with 1- and 2- degree functions.
| 

enumeration BMM_OPERATOR_POSITION
    base_type String

feature_group ("values")

    | 
    | Prefix operator position: operator comes before operand.
    | 
    prefix ("prefix");

    | 
    | Infix operator position: operator comes between left and right operands.
    | 
    infix ("infix");


end
